{
  "name": "glaam-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev:11ty": "eleventy --serve",
    "dev:css": "tailwindcss -i ./src/style.css -o ./_site/css/style.css --watch",
    "dev": "npm-run-all --parallel dev:*",
    "build:11ty": "eleventy",
    "build:css": "tailwindcss -i ./src/style.css -o ./_site/css/style.css --minify",
    "build": "npm-run-all build:css build:11ty",
    "format": "prettier --write \"src/**/*.{html,njk,md,js,css}\""
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.12.0"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.2",
    "@eslint/js": "^9.39.1",
    "@tailwindcss/cli": "^4.2.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.6",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4.2.1",
    "vite": "^7.2.4"
  },
  "description": "This template provides a minimal setup to get React working in Vite with HMR and some ESLint rules.",
  "main": "eslint.config.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GLAAM-dev/website.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/GLAAM-dev/website/issues"
  },
  "homepage": "https://github.com/GLAAM-dev/website#readme"
}