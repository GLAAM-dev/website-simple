            Events Calendar
          </a>
        </div>
      </div>

      <!-- Image Grid -->
      <div class="mt-16 sm:mt-24 lg:col-span-6 lg:mt-0">
        <div class="animate-float grid grid-cols-2 gap-4">
          <div class="grid gap-4">
            <div
              class="group relative overflow-hidden rounded-3xl shadow-lg ring-1 ring-gray-900/5"
            >
              <img
                src="/hero-1.jpg"
                alt="Mensa Members Socializing"
                class="h-48 w-full object-cover scale-125 transition-transform duration-700 group-hover:scale-150"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-gray-900/60 to-transparent"></div>
            </div>
            <div
              class="group relative overflow-hidden rounded-3xl shadow-lg ring-1 ring-gray-900/5"
            >
              <img
                src="/hero-2.jpg"
                alt="Board Game Night"
                class="h-64 w-full object-cover scale-125 transition-transform duration-700 group-hover:scale-150"
              />
              <div
                class="from-brand-primary/60 absolute inset-0 bg-gradient-to-t to-transparent"
              ></div>
            </div>
          </div>
          <div class="grid gap-4 pt-12">
            <div
              class="group relative overflow-hidden rounded-3xl shadow-lg ring-1 ring-gray-900/5"
            >
              <img
                src="/hero-3.jpg"
                alt="Dinner Gathering"
                class="h-64 w-full object-cover transition-transform duration-700 group-hover:scale-110"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-gray-900/60 to-transparent"></div>
            </div>
            <div
              class="group bg-brand-accent relative flex h-48 items-center justify-center overflow-hidden rounded-3xl p-8 shadow-lg ring-1 ring-gray-900/5"
            >
              <p class="text-center text-3xl leading-tight font-extrabold text-white">
                1,700+
                <br />
                <span class="text-lg font-medium opacity-90">Members in LA</span>
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>


