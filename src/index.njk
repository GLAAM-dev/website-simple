<!-- Hero Section -->
<section class="relative overflow-hidden bg-white pt-20 pb-32 lg:pt-32 lg:pb-40">
  <!-- Decorative background elements -->
  <div
    class="absolute inset-y-0 right-1/2 -z-10 mr-16 w-[200%] origin-bottom-left skew-x-[-30deg] bg-white shadow-xl ring-1 shadow-blue-100/20 ring-blue-50 sm:mr-28 lg:mr-0 xl:mr-16 xl:origin-center"
  ></div>
  <div class="absolute top-0 right-0 -z-10 h-full w-1/2 bg-blue-50/50"></div>

