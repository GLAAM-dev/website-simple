<!-- How to Join (Call to Action) -->
<section id="join" class="py-24 bg-brand-primary text-white text-center">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-4xl md:text-5xl font-extrabold mb-6">Ready to Join Us?</h2>
    <p class="text-xl text-blue-100 mb-12 max-w-2xl mx-auto">
      There are two ways to qualify for membership: submit prior evidence of a qualifying score from another standardized test, or take the official Mensa Admissions Test.
    </p>
    
    <div class="grid sm:grid-cols-2 gap-6 max-w-3xl mx-auto mb-12">
      <div class="bg-white/10 backdrop-blur-sm border border-white/20 p-8 rounded-2xl">
        <h3 class="text-2xl font-bold mb-4">Submit Prior Evidence</h3>
        <p class="text-blue-100 text-sm mb-6 flex-grow">Have you taken the LSAT, GMAT, or a recognized IQ test? You might already qualify!</p>
        <a href="https://www.us.mensa.org/join/submitscores/" target="_blank" rel="noopener noreferrer" class="block w-full py-3 px-4 bg-transparent border-2 border-white rounded-xl font-bold hover:bg-white hover:text-brand-primary transition-colors">
          Check Qualifying Tests
        </a>
      </div>
      
      <div class="bg-brand-accent text-gray-900 p-8 rounded-2xl transform sm:-translate-y-4 shadow-2xl border-4 border-white">
        <div class="bg-white px-3 py-1 rounded-full text-xs font-bold tracking-wider uppercase inline-block mb-4 text-brand-primary">Most Popular</div>
        <h3 class="text-2xl font-bold mb-4">Take the Test</h3>
        <p class="text-gray-800 text-sm mb-6 flex-grow">Find a local testing session in the Los Angeles area or take the private test online.</p>
        <a href="https://www.us.mensa.org/join/testing/" target="_blank" rel="noopener noreferrer" class="block w-full py-3 px-4 bg-gray-900 text-white rounded-xl font-bold hover:bg-gray-800 transition-colors shadow-md">
          Find a Testing Session
        </a>
      </div>
    </div>
    
    <p class="text-sm text-blue-200">
      Already a member? <a href="/resources/" class="underline hover:text-white font-semibold">Visit the Members Resource Hub</a>
    </p>
  </div>
