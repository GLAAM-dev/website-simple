<div class="bg-gray-800 text-white py-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center pt-8">
    <h1 class="text-4xl md:text-5xl font-extrabold mb-4">Member Resources</h1>
    <p class="text-xl text-gray-300 max-w-2xl mx-auto">
      Your portal to local events, leadership contacts, and everything you need to make the most of your GLAAM membership.
    </p>
  </div>
</div>

<div class="py-12 bg-bg-subtle">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-3 gap-8">
      
      <!-- Main Content (Events / What's Happening) -->
      <div class="lg:col-span-2 space-y-8">
        <section class="bg-white p-8 rounded-2xl shadow-sm border border-gray-100">
          <div class="flex justify-between items-center mb-6">
            <h2 class="text-2xl font-bold text-gray-900 flex items-center gap-2">
              <svg class="w-6 h-6 text-brand-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
              What's Happening?
            </h2>
            <a href="#" class="text-sm font-semibold text-brand-primary hover:text-blue-800">View Full Calendar &rarr;</a>
          </div>
          
          <div class="space-y-6">
            <!-- Event 1 -->
            <div class="flex gap-4 p-4 rounded-xl hover:bg-gray-50 transition-colors border border-transparent hover:border-gray-100">
              <div class="flex-shrink-0 w-16 h-16 bg-blue-50 bg-opacity-50 rounded-lg flex flex-col items-center justify-center text-brand-primary border border-blue-100">
                <span class="text-xs font-bold uppercase tracking-wider">Oct</span>
                <span class="text-xl font-bold">14</span>
              </div>
              <div>
                <h3 class="font-bold text-lg text-gray-900">Pasadena Dinner Group</h3>
                <p class="text-sm text-gray-500 mb-2">7:00 PM • True Food Kitchen, Pasadena</p>
                <p class="text-gray-600">Join us for our monthly casual dinner. RSVP required by the 12th.</p>
              </div>
            </div>

            <!-- Event 2 -->
            <div class="flex gap-4 p-4 rounded-xl hover:bg-gray-50 transition-colors border border-transparent hover:border-gray-100">
              <div class="flex-shrink-0 w-16 h-16 bg-blue-50 bg-opacity-50 rounded-lg flex flex-col items-center justify-center text-brand-primary border border-blue-100">
                <span class="text-xs font-bold uppercase tracking-wider">Oct</span>
                <span class="text-xl font-bold">18</span>
              </div>
              <div>
                <h3 class="font-bold text-lg text-gray-900">Board Game Saturdays</h3>
                <p class="text-sm text-gray-500 mb-2">1:00 PM - 5:00 PM • West LA Library</p>
                <p class="text-gray-600">Bring your favorite Euro-games or party games. Open to families.</p>
              </div>
            </div>

            <!-- Event 3 -->
            <div class="flex gap-4 p-4 rounded-xl hover:bg-gray-50 transition-colors border border-transparent hover:border-gray-100">
              <div class="flex-shrink-0 w-16 h-16 bg-yellow-50 bg-opacity-50 rounded-lg flex flex-col items-center justify-center text-brand-accent border border-yellow-200">
                <span class="text-xs font-bold uppercase tracking-wider">Oct</span>
                <span class="text-xl font-bold">25</span>
              </div>
              <div>
                <div class="inline-block bg-brand-accent text-white text-xs px-2 py-0.5 rounded-full font-bold mb-1">Featured</div>
                <h3 class="font-bold text-lg text-gray-900">Virtual Lecture: Astrophysics Today</h3>
                <p class="text-sm text-gray-500 mb-2">8:00 PM • Zoom</p>
                <p class="text-gray-600">Guest speaker Dr. Sarah Chen on the latest discoveries from the JWST.</p>
              </div>
            </div>
          </div>
        </section>

        <!-- Newsletter & Connect Callout -->
        <section class="bg-gradient-to-br from-brand-primary to-blue-900 rounded-2xl shadow-md text-white overflow-hidden relative">
