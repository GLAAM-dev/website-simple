            <div class="flex flex-col gap-3 min-w-[200px]">
              <a href="https://connect.us.mensa.org" target="_blank" rel="noopener noreferrer" class="bg-brand-accent hover:bg-yellow-400 text-gray-900 font-bold py-3 px-6 rounded-xl text-center transition-colors shadow-sm">
                Mensa Connect &rarr;
