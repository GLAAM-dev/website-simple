---
layout: base.njk
title: "GLAAM Member Resources"
---

<div class="bg-gray-800 py-16 text-white">
  <div class="mx-auto max-w-7xl px-4 pt-8 text-center sm:px-6 lg:px-8">
    <h1 class="mb-4 text-4xl font-extrabold md:text-5xl">Member Resources</h1>
    <p class="mx-auto max-w-2xl text-xl text-gray-300">
      Your portal to local events, leadership contacts, and everything you need to make the most of
      your GLAAM membership.
    </p>
  </div>
</div>

<div class="bg-bg-subtle py-12">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid gap-8 lg:grid-cols-3">
      <!-- Main Content (Events / What's Happening) -->
      <div class="space-y-8 lg:col-span-2">
        <section class="rounded-2xl border border-gray-100 bg-white p-8 shadow-sm">
          <div class="mb-6 flex items-center justify-between">
            <h2 class="flex items-center gap-2 text-2xl font-bold text-gray-900">
              <svg
                class="text-brand-primary h-6 w-6"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                ></path>
              </svg>
              What's Happening?
            </h2>
            <a href="https://lu.ma/glaam" class="text-brand-primary text-sm font-semibold hover:text-blue-800" target="_blank" rel="noopener noreferrer">
              View Full Calendar &rarr;
            </a>
          </div>

          <div class="space-y-6">
            <!-- Event 1 -->
            <div
              class="flex gap-4 rounded-xl border border-transparent p-4 transition-colors hover:border-gray-100 hover:bg-gray-50"
            >
              <div
                class="bg-opacity-50 text-brand-primary flex h-16 w-16 flex-shrink-0 flex-col items-center justify-center rounded-lg border border-blue-100 bg-blue-50"
              >
                <span class="text-xs font-bold tracking-wider uppercase">Oct</span>
                <span class="text-xl font-bold">14</span>
              </div>
              <div>
                <h3 class="text-lg font-bold text-gray-900">Pasadena Dinner Group</h3>
                <p class="mb-2 text-sm text-gray-500">7:00 PM • True Food Kitchen, Pasadena</p>
                <p class="text-gray-600">
                  Join us for our monthly casual dinner. RSVP required by the 12th.
                </p>
              </div>
            </div>

            <!-- Event 2 -->
            <div
              class="flex gap-4 rounded-xl border border-transparent p-4 transition-colors hover:border-gray-100 hover:bg-gray-50"
            >
              <div
                class="bg-opacity-50 text-brand-primary flex h-16 w-16 flex-shrink-0 flex-col items-center justify-center rounded-lg border border-blue-100 bg-blue-50"
              >
                <span class="text-xs font-bold tracking-wider uppercase">Oct</span>
                <span class="text-xl font-bold">18</span>
              </div>
              <div>
                <h3 class="text-lg font-bold text-gray-900">Board Game Saturdays</h3>
                <p class="mb-2 text-sm text-gray-500">1:00 PM - 5:00 PM • West LA Library</p>
                <p class="text-gray-600">
                  Bring your favorite Euro-games or party games. Open to families.
                </p>
              </div>
            </div>

            <!-- Event 3 -->
            <div
              class="flex gap-4 rounded-xl border border-transparent p-4 transition-colors hover:border-gray-100 hover:bg-gray-50"
            >
              <div
                class="bg-opacity-50 text-brand-accent flex h-16 w-16 flex-shrink-0 flex-col items-center justify-center rounded-lg border border-yellow-200 bg-yellow-50"
              >
                <span class="text-xs font-bold tracking-wider uppercase">Oct</span>
                <span class="text-xl font-bold">25</span>
              </div>
              <div>
                <div
                  class="bg-brand-accent mb-1 inline-block rounded-full px-2 py-0.5 text-xs font-bold text-white"
                >
                  Featured
                </div>
                <h3 class="text-lg font-bold text-gray-900">Virtual Lecture: Astrophysics Today</h3>
                <p class="mb-2 text-sm text-gray-500">8:00 PM • Zoom</p>
                <p class="text-gray-600">
                  Guest speaker Dr. Sarah Chen on the latest discoveries from the JWST.
                </p>
              </div>
            </div>
          </div>
        </section>

        <!-- Newsletter & Connect Callout -->
        <section
          class="from-brand-primary relative overflow-hidden rounded-2xl bg-gradient-to-br to-blue-900 text-white shadow-md"
        >
          <div
            class="absolute inset-0 mt-32 bg-[url('https://www.transparenttextures.com/patterns/cubes.png')] pt-16 opacity-10"
          ></div>
          <div class="relative z-10 items-center justify-between p-8 sm:flex">
            <div class="mb-6 sm:mr-6 sm:mb-0">
              <h3 class="mb-2 text-2xl font-bold">Join the Conversation</h3>
              <p class="text-blue-100">
                Connect with other members online via our private Mensa Connect portal and social
                media groups.
              </p>
            </div>
            <div class="flex min-w-[200px] flex-col gap-3">
              <a
                href="https://connect.us.mensa.org"
                target="_blank"
                rel="noopener noreferrer"
                class="bg-brand-accent rounded-xl px-6 py-3 text-center font-bold text-gray-900 shadow-sm transition-colors hover:bg-yellow-400"
              >
                Mensa Connect &rarr;
              </a>
              <a
                href="https://facebook.com/groups/MensaLA/"
                target="_blank" rel="noopener noreferrer"
                class="rounded-xl bg-white/20 px-6 py-3 text-center font-semibold text-white transition-colors hover:bg-white/30"
              >
                Facebook Group
              </a>
            </div>
          </div>
        </section>
      </div>

      <!-- Sidebar (Contact & Quick Links) -->
      <div class="space-y-8">
        <!-- Contact Us -->
        <section class="rounded-2xl border border-gray-100 bg-white p-6 shadow-sm">
          <h2 class="mb-4 border-b border-gray-100 pb-2 text-xl font-bold text-gray-900">
            How to Contact Us
          </h2>

          <div class="space-y-4">
            <div>
              <h4 class="text-sm font-bold tracking-wider text-gray-800 uppercase">
                Chapter Board
              </h4>
              <ul class="mt-2 space-y-3">
                <li class="flex items-start">
                  <svg
                    class="mt-0.5 mr-2 h-5 w-5 text-gray-400"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
                    ></path>
                  </svg>
                  <div>
                    <p class="text-sm font-medium text-gray-900">Local Secretary</p>
                    <a
                      href="mailto:locsec@glaam.org"
                      class="text-brand-primary text-sm hover:underline"
                    >
                      locsec@glaam.org
                    </a>
                  </div>
                </li>
                <li class="flex items-start">
                  <svg
                    class="mt-0.5 mr-2 h-5 w-5 text-gray-400"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9.5a2.5 2.5 0 00-2.5-2.5H14"
                    ></path>
                  </svg>
                  <div>
                    <p class="text-sm font-medium text-gray-900">Newsletter Editor</p>
                    <a
                      href="mailto:editor@glaam.org"
                      class="text-brand-primary text-sm hover:underline"
                    >
                      editor@glaam.org
                    </a>
                  </div>
                </li>
              </ul>
            </div>

            <div class="border-t border-gray-100 pt-4">
              <a
                href="/contact"
                class="hover:text-brand-primary flex items-center gap-1 text-sm font-semibold text-gray-700"
              >
                View Full Leadership Directory
                <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                  <path
                    fill-rule="evenodd"
                    d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
                    clip-rule="evenodd"
                  ></path>
                </svg>
              </a>
            </div>
          </div>
        </section>

        <!-- Quick Links -->
        <section class="rounded-2xl border border-gray-200 bg-gray-50 p-6">
          <h2 class="mb-4 text-xl font-bold text-gray-900">Quick Links</h2>
          <ul class="space-y-3">
            <li>
              <a
                href="/resources/"
                class="hover:border-brand-primary group block rounded-xl border border-gray-100 bg-white p-3 shadow-sm transition-all hover:shadow"
              >
                <div class="group-hover:text-brand-primary font-bold text-gray-800">
                  L.A. Mentary Newsletter
                </div>
                <div class="text-xs text-gray-500">Download the latest PDF</div>
              </a>
            </li>
            <li>
              <a
                href="/about"
                class="hover:border-brand-primary group block rounded-xl border border-gray-100 bg-white p-3 shadow-sm transition-all hover:shadow"
              >
                <div class="group-hover:text-brand-primary font-bold text-gray-800">
                  Bylaws & Governance
                </div>
                <div class="text-xs text-gray-500">Review our chapter rules</div>
              </a>
            </li>
            <li>
              <a
                href="https://www.us.mensa.org/login/"
                target="_blank"
                rel="noopener noreferrer"
                class="hover:border-brand-primary group block rounded-xl border border-gray-100 bg-white p-3 shadow-sm transition-all hover:shadow"
              >
                <div class="group-hover:text-brand-primary font-bold text-gray-800">
                  National Member Login
                </div>
                <div class="text-xs text-gray-500">Manage your profile & dues</div>
              </a>
            </li>
          </ul>
        </section>
      </div>
    </div>
  </div>
</div>
