<script>
    document.addEventListener('DOMContentLoaded', () => {
        const btns = document.querySelectorAll('.tab-btn');
        const contents = document.querySelectorAll('.tab-content');

        function visibleHistoryTab() {
            return document.querySelector('.tab-content:not(.hidden)');
        }

        function setAllDetailsOpen(open) {
            const panel = visibleHistoryTab();
            if (!panel) return;
            panel.querySelectorAll('details').forEach(function (el) {
                el.open = open;
            });
        }

        document.getElementById('history-expand-details')?.addEventListener('click', function () {
            setAllDetailsOpen(true);
        });
        document.getElementById('history-collapse-details')?.addEventListener('click', function () {
            setAllDetailsOpen(false);
        });

        btns.forEach(btn => {
            btn.addEventListener('click', () => {
                // Remove active from all
                btns.forEach(b => {
                    b.classList.remove('bg-white', 'text-brand-primary', 'shadow-lg', 'ring-2', 'ring-brand-primary/20');
                    b.classList.add('bg-white/80', 'text-gray-500');
                });
                contents.forEach(c => c.classList.add('hidden'));

                // Add active to clicked
                btn.classList.add('bg-white', 'text-brand-primary', 'shadow-lg', 'ring-2', 'ring-brand-primary/20');
                btn.classList.remove('bg-white/80', 'text-gray-500');
                
                const targetId = btn.getAttribute('data-target');
                document.getElementById(targetId).classList.remove('hidden');
            });
        });
    });
</script>

